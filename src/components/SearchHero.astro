---
interface Props {
  headline?: string;
  subheadline?: string;
}

const {
  headline = 'Instant India PIN Code & Post Office Finder',
  subheadline = 'Search 157,126+ post offices, calculate Speed Post delivery tariffs, and format courier addresses with zero wait time.'
} = Astro.props;

const popularCities = [
  { name: 'Bangalore (560001)', pin: '560001' },
  { name: 'New Delhi (110001)', pin: '110001' },
  { name: 'Mumbai (400001)', pin: '400001' },
  { name: 'Chennai (600001)', pin: '600001' },
  { name: 'Hyderabad (500001)', pin: '500001' },
  { name: 'Kolkata (700001)', pin: '700001' },
  { name: 'Pune (411001)', pin: '411001' },
  { name: 'Ahmedabad (380001)', pin: '380001' },
];
---

<section class="relative bg-gradient-to-b from-pinDark-950 via-pinDark-900 to-slate-900 text-white pt-14 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
  
  <!-- Hero Cartoon / Vector Delivery Illustration Banner Background -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden select-none">
    <img 
      src="/hero-banner.jpg" 
      alt="Indian Postal & Courier Delivery Illustration" 
      class="w-full h-full object-cover object-center opacity-30 md:opacity-35 scale-105 transition-opacity"
      loading="eager"
    />
    <!-- Ambient Gradient Overlay for 100% Readability -->
    <div class="absolute inset-0 bg-gradient-to-b from-pinDark-950/85 via-pinDark-900/65 to-slate-900/95"></div>
  </div>

  <!-- Decorative Glowing Brand Blobs -->
  <div class="absolute inset-0 bg-grid-pattern opacity-10 pointer-events-none"></div>
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-500/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-accent-500/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-4xl mx-auto text-center space-y-6 z-10">
    
    <!-- Trust Pill matching Logo colors -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-pinDark-800/90 border border-slate-700/80 text-xs font-medium text-slate-200 shadow-md backdrop-blur-sm">
      <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-accent-500 text-pinDark-950 text-[10px] font-bold">⚡</span>
      <span class="text-white font-semibold">India Postal Data Reference</span>
      <span class="text-slate-400">• 2026 Updated</span>
    </div>

    <!-- Main Headline with Emerald and Golden accents -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-tight text-white drop-shadow-sm">
      Instant India <span class="text-brand-400">PIN Code</span> & Post Office Finder
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg text-slate-200 max-w-2xl mx-auto leading-relaxed drop-shadow-sm">
      {subheadline}
    </p>

    <!-- Search Input Box -->
    <div class="relative max-w-2xl mx-auto mt-8 text-left">
      <div class="relative flex items-center bg-white rounded-2xl shadow-2xl p-2 focus-within:ring-4 focus-within:ring-brand-500/40 transition-all">
        <div class="pl-3.5 pr-2 text-slate-400">
          <svg class="w-6 h-6 text-pinDark-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>

        <input 
          type="text" 
          id="globalSearchInput" 
          placeholder="Enter 6-digit PIN (e.g. 560001) or Area / Post Office name..."
          autocomplete="off"
          class="w-full text-slate-900 placeholder-slate-400 text-base sm:text-lg py-2.5 px-2 bg-transparent focus:outline-none font-medium"
        />

        <button 
          id="searchSubmitBtn" 
          class="hidden sm:inline-flex items-center justify-center px-6 py-3 rounded-xl bg-gradient-to-r from-brand-600 to-brand-700 hover:from-brand-500 hover:to-brand-600 text-white font-semibold text-sm shadow-md transition-all active:scale-95"
        >
          <span class="mr-1 text-accent-300 font-bold">⚡</span> Find PIN
        </button>
      </div>

      <!-- Autocomplete Dropdown List -->
      <div 
        id="searchResultsDropdown" 
        class="hidden absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden z-50 max-h-96 overflow-y-auto"
      >
        <div id="searchResultsList" class="divide-y divide-slate-100"></div>
      </div>
    </div>

    <!-- Quick Navigation Popular Chips -->
    <div class="pt-4 flex flex-wrap items-center justify-center gap-2 text-xs">
      <span class="text-slate-400 font-medium">Popular:</span>
      {popularCities.map((c) => (
        <a 
          href={`/pincode/${c.pin}`}
          class="px-2.5 py-1 rounded-full bg-pinDark-800/90 border border-slate-700 text-slate-300 hover:text-white hover:border-brand-500 hover:bg-pinDark-800 transition-colors"
        >
          {c.name}
        </a>
      ))}
    </div>

    <!-- Micro Stats Row with Brand Colors -->
    <div class="pt-8 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center border-t border-slate-800/80 max-w-3xl mx-auto">
      <div>
        <div class="text-2xl font-bold text-white tracking-tight">157,126+</div>
        <div class="text-xs text-brand-300 font-medium">Post Offices</div>
      </div>
      <div>
        <div class="text-2xl font-bold text-white tracking-tight">19,300+</div>
        <div class="text-xs text-brand-300 font-medium">Unique PIN Codes</div>
      </div>
      <div>
        <div class="text-2xl font-bold text-white tracking-tight">737</div>
        <div class="text-xs text-brand-300 font-medium">Postal Districts</div>
      </div>
      <div>
        <div class="text-2xl font-bold text-white tracking-tight">36</div>
        <div class="text-xs text-brand-300 font-medium">States & UTs</div>
      </div>
    </div>

  </div>
</section>

<script>
  let searchData = null;
  let isFetching = false;

  const input = document.getElementById('globalSearchInput') as HTMLInputElement;
  const dropdown = document.getElementById('searchResultsDropdown');
  const resultsList = document.getElementById('searchResultsList');

  async function loadSearchIndex() {
    if (searchData || isFetching) return;
    isFetching = true;
    try {
      const res = await fetch('/search_index.json');
      searchData = await res.json();
    } catch (e) {
      console.error('Failed to load search index', e);
    } finally {
      isFetching = false;
    }
  }

  if (input) {
    input.addEventListener('focus', loadSearchIndex);

    input.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      if (!query || query.length < 2) {
        if (dropdown) dropdown.classList.add('hidden');
        return;
      }

      if (!searchData) return;

      const isDigitsOnly = /^\d+$/.test(query);
      const matches = [];

      for (let i = 0; i < searchData.length; i++) {
        const item = searchData[i];
        const pin = item[0];
        const office = item[1].toLowerCase();
        const dist = item[2].toLowerCase();
        const state = item[3].toLowerCase();

        if (isDigitsOnly) {
          if (pin.startsWith(query)) {
            matches.push(item);
          }
        } else {
          if (office.includes(query) || dist.includes(query) || pin.includes(query) || state.includes(query)) {
            matches.push(item);
          }
        }

        if (matches.length >= 10) break;
      }

      renderResults(matches, query);
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target as Node) && dropdown && !dropdown.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
      }
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const val = input.value.trim();
        if (/^\d{6}$/.test(val)) {
          window.location.href = `/pincode/${val}`;
        }
      }
    });
  }

  function renderResults(items: any[], query: string) {
    if (!dropdown || !resultsList) return;

    if (items.length === 0) {
      resultsList.innerHTML = `
        <div class="p-4 text-center text-sm text-slate-500">
          No matching PIN code or post office found for "<span class="font-medium text-slate-800">${query}</span>".
        </div>
      `;
      dropdown.classList.remove('hidden');
      return;
    }

    resultsList.innerHTML = items.map((item) => `
      <a 
        href="/pincode/${item[0]}" 
        class="flex items-center justify-between p-3.5 hover:bg-slate-50 transition-colors group cursor-pointer"
      >
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 font-mono font-bold flex items-center justify-center text-sm border border-brand-200 group-hover:bg-brand-600 group-hover:text-white transition-colors">
            ${item[0]}
          </div>
          <div>
            <div class="text-sm font-semibold text-slate-900 group-hover:text-brand-600 transition-colors">
              ${item[1] || 'Post Office'}
            </div>
            <div class="text-xs text-slate-500">
              ${item[2]}, ${item[3]}
            </div>
          </div>
        </div>
        <div class="text-xs font-semibold text-brand-600 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          View Details
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </a>
    `).join('');

    dropdown.classList.remove('hidden');
  }
</script>
