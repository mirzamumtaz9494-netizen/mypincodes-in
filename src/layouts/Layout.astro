---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  activePage?: string;
  schemaJson?: any;
}

const {
  title = 'MyPincodes.in - All India PIN Code & Post Office Directory',
  description = 'Find all India PIN codes, post offices, Speed Post rate calculator, and courier tools. Instant lookup for 157,126+ post offices across 19,300+ postal codes.',
  canonical = Astro.url.href,
  activePage = 'home',
  schemaJson
} = Astro.props;

const siteUrl = 'https://mypincodes.in';

// Default schema for WebSite with search action
const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'MyPincodes.in',
  url: siteUrl,
  description: description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="MyPincodes.in" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google Font (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaJson || defaultSchema)} />

    <!-- Google AdSense Ready Tag (Will activate once client AdSense ID is provided) -->
    <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXX" crossorigin="anonymous"></script> -->
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans">
    <Navbar activePage={activePage} />
    
    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
