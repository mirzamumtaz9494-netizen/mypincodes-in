---
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

const guides = [
  {
    title: 'How Indian PIN Codes Work: 6-Digit Postal System Explained',
    slug: '/guides/how-pincode-system-works-india',
    description: 'Learn the architectural breakdown of the 6-digit PIN code system, 9 postal zones, sorting districts, and how 157,000+ post offices are mapped across India.',
    tag: 'Postal Architecture',
    readTime: '7 min read',
    icon: '📍'
  },
  {
    title: 'Speed Post Tracking Guide: How to Track Articles Online & via SMS',
    slug: '/guides/india-post-speed-post-tracking-guide',
    description: 'Understand 13-digit consignment barcode numbers (EE, EM, SP), tracking via SMS to 51969 without internet, and official compensation rules for delayed deliveries.',
    tag: 'Tracking & Delivery',
    readTime: '6 min read',
    icon: '⚡'
  },
  {
    title: 'Official India Post Speed Post Rate Chart 2026',
    slug: '/speed-post-rates-chart',
    description: 'Comprehensive domestic postal tariff matrix across all weight brackets (up to 35 kg), distance slabs, delivery transit norms, and calculated 18% GST.',
    tag: 'Tariffs & Rates',
    readTime: '8 min read',
    icon: '📊'
  },
  {
    title: 'Courier Packaging & Addressing Guidelines for India Post & DTDC',
    slug: '/guides/courier-address-packaging-guidelines',
    description: 'Standard 4-line address formatting, barcode label placement, parcel dimension restrictions, and prohibited articles under the Indian Post Office Act.',
    tag: 'Logistics Best Practices',
    readTime: '5 min read',
    icon: '📦'
  }
];
---

<Layout
  title="Postal Guides & Logistics Knowledge Hub - MyPincodes.in"
  description="Comprehensive educational guides on Indian PIN codes, India Post Speed Post tariffs, barcode tracking via SMS, and courier address standards for DTDC, Blue Dart, and Delhivery."
  canonical="https://mypincodes.in/guides"
  activePage="guides"
>
  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-pinDark-950 via-pinDark-900 to-slate-900 text-white py-14 px-4 sm:px-6 lg:px-8 text-center border-b border-slate-800">
    <div class="max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-pinDark-800 border border-slate-700 text-xs font-semibold text-accent-400 uppercase tracking-wider">
        <span>📚</span> Postal Knowledge Hub
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Postal Guides & Courier Knowledge Base
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Expert reference articles, tariff breakdowns, and logistics tutorials to help citizens, shippers, and small businesses navigate India's postal network.
      </p>
    </div>
  </div>

  <!-- Guides Grid -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {guides.map((guide) => (
        <a 
          href={guide.slug}
          class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 hover:border-brand-500 hover:shadow-xl transition-all group flex flex-col justify-between"
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                {guide.icon}
              </span>
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 text-[11px] font-semibold">
                  {guide.readTime}
                </span>
                <span class="px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-700 text-[11px] font-semibold border border-brand-200">
                  {guide.tag}
                </span>
              </div>
            </div>

            <h2 class="text-xl font-bold text-slate-900 group-hover:text-brand-600 transition-colors leading-snug">
              {guide.title}
            </h2>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {guide.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-brand-600">
            <span>Read Complete Guide</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Quick Tool Access Banner -->
    <div class="mt-14 bg-gradient-to-r from-brand-600 to-emerald-700 rounded-2xl p-6 sm:p-8 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl shadow-brand-600/10">
      <div>
        <h3 class="text-xl font-bold">Need instant calculations or address formatting?</h3>
        <p class="text-xs sm:text-sm text-emerald-100 mt-1">Access our suite of free postal tools built for 157,000+ Indian post offices.</p>
      </div>
      <div class="flex items-center gap-3">
        <a href="/speed-post-calculator" class="px-4 py-2.5 rounded-xl bg-white text-brand-700 font-bold text-xs uppercase tracking-wider hover:bg-emerald-50 transition-all shadow-md">
          Speed Post Calculator
        </a>
        <a href="/address-formatter" class="px-4 py-2.5 rounded-xl bg-emerald-900/60 border border-emerald-400 text-white font-bold text-xs uppercase tracking-wider hover:bg-emerald-900/80 transition-all">
          Address Formatter
        </a>
      </div>
    </div>
  </div>
</Layout>
