---
import Layout from '../layouts/Layout.astro';
import { getAllStates } from '../utils/postalData';

export const prerender = true;

const states = getAllStates();
const totalPincodes = states.reduce((acc, s) => acc + s.pincodesCount, 0);
const totalOffices = states.reduce((acc, s) => acc + s.officesCount, 0);
const totalDistricts = states.reduce((acc, s) => acc + s.districtsCount, 0);
---

<Layout 
  title="All 36 States & Union Territories PIN Code Directory - India Post"
  description="Browse postal codes and post offices across all 36 States & Union Territories of India. Complete directory covering 737 districts and 157,126+ post offices."
  activePage="states"
>
  <div class="bg-gradient-to-b from-pinDark-950 via-pinDark-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 text-center border-b border-slate-800">
    <div class="max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-pinDark-800 border border-slate-700 text-xs font-semibold text-brand-300 uppercase tracking-wider">
        Complete National Directory
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        India States & Union Territories Postal Directory
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto">
        Directory covering all 28 States and 8 Union Territories under the Department of Posts (India Post).
      </p>

      <!-- Stats Bar -->
      <div class="pt-6 grid grid-cols-3 gap-4 max-w-md mx-auto text-center border-t border-slate-800">
        <div>
          <div class="text-xl font-bold text-white">{totalDistricts}</div>
          <div class="text-xs text-slate-400">Districts</div>
        </div>
        <div>
          <div class="text-xl font-bold text-white">{totalPincodes.toLocaleString('en-IN')}</div>
          <div class="text-xs text-slate-400">PIN Codes</div>
        </div>
        <div>
          <div class="text-xl font-bold text-white">{totalOffices.toLocaleString('en-IN')}</div>
          <div class="text-xs text-slate-400">Post Offices</div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
      {states.map((st) => (
        <a 
          href={`/state/${st.slug}`}
          class="bg-white rounded-2xl p-5 border border-slate-200/80 hover:border-brand-500 hover:shadow-lg transition-all group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between">
              <h2 class="text-base font-bold text-slate-900 group-hover:text-brand-600 transition-colors">
                {st.name}
              </h2>
              <span class="text-xs font-bold text-brand-600 group-hover:translate-x-1 transition-transform">→</span>
            </div>
            <div class="mt-3 space-y-1 text-xs text-slate-500">
              <div class="flex justify-between">
                <span>Districts:</span>
                <span class="font-semibold text-slate-700">{st.districtsCount}</span>
              </div>
              <div class="flex justify-between">
                <span>Unique PINs:</span>
                <span class="font-semibold text-slate-700">{st.pincodesCount.toLocaleString('en-IN')}</span>
              </div>
              <div class="flex justify-between">
                <span>Post Offices:</span>
                <span class="font-semibold text-slate-700">{st.officesCount.toLocaleString('en-IN')}</span>
              </div>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] font-semibold text-brand-600">
            Browse All Districts & PINs
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
