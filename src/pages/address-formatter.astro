---
import Layout from '../layouts/Layout.astro';
import AddressFormatter from '../components/AddressFormatter.astro';

export const prerender = true;
---

<Layout 
  title="Courier & Postal Address Standardizer - Barcode Ready Shipping Labels"
  description="Convert messy customer addresses into standardized India Post & courier shipping formats. Instant one-click copy for BlueDart, Delhivery, Amazon, DTDC & Flipkart packages."
  activePage="formatter"
>
  <div class="bg-gradient-to-b from-pinDark-950 via-pinDark-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 text-center border-b border-slate-800">
    <div class="max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-pinDark-800 border border-slate-700 text-xs font-semibold text-brand-300 uppercase tracking-wider">
        Logistics & E-Commerce Utility
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Courier & Postal Address Standardizer
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto">
        Avoid non-delivery returns (RTO) by generating clean, standardized postal labels formatted to Department of Posts and courier barcode standards.
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <AddressFormatter />

    <div class="mt-12 bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8">
      <h2 class="text-lg font-bold text-slate-900 mb-3">Guidelines for Addressing Mail in India</h2>
      <ul class="space-y-2 text-xs text-slate-600 list-disc list-inside leading-relaxed">
        <li>The recipient name and mobile number should always be clearly legible on top and bottom lines.</li>
        <li>Always write the correct 6-digit PIN code without any spaces or dashes in the destination line.</li>
        <li>Landmarks are helpful for local last-mile delivery partners but should not replace the locality or house number.</li>
        <li>For Speed Post and registered articles, providing a valid mobile number enables SMS delivery updates to the consignee.</li>
      </ul>
    </div>
  </div>
</Layout>
