---
import Layout from '../../../layouts/Layout.astro';
import { getAllDistricts, getStateBySlug } from '../../../utils/postalData';

export const prerender = true;

export async function getStaticPaths() {
  const districts = getAllDistricts();
  return districts.map((d) => ({
    params: { stateSlug: d.stateSlug, districtSlug: d.slug },
    props: { district: d }
  }));
}

const { district } = Astro.props;
const state = getStateBySlug(district.stateSlug);

// Breadcrumbs Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://mypincodes.in'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: district.state,
      item: `https://mypincodes.in/state/${district.stateSlug}`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `${district.name} District`,
      item: `https://mypincodes.in/district/${district.stateSlug}/${district.slug}`
    }
  ]
};
---

<Layout 
  title={`${district.name} PIN Codes List - ${district.state} Post Offices`}
  description={`List of all ${district.pincodes.length} PIN codes and ${district.officesCount} post offices in ${district.name} district, ${district.state}. View delivery status, office type, and Speed Post tariffs.`}
  activePage="states"
  schemaJson={breadcrumbSchema}
>
  <!-- Breadcrumbs -->
  <div class="bg-slate-100 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 text-xs text-slate-500 flex items-center gap-2">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>/</span>
      <a href={`/state/${district.stateSlug}`} class="hover:text-brand-600">{district.state}</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">{district.name} District</span>
    </div>
  </div>

  <div class="bg-gradient-to-b from-pinDark-950 via-pinDark-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 text-center border-b border-slate-800">
    <div class="max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-pinDark-800 border border-slate-700 text-xs font-semibold text-brand-300 uppercase tracking-wider">
        Postal District Directory
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        {district.name} District PIN Codes
      </h1>
      <p class="text-slate-300 text-sm max-w-xl mx-auto">
        Located in {district.state}. Explore all {district.pincodes.length} postal codes covering {district.officesCount} post offices.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-slate-900">
        PIN Codes in {district.name} ({district.pincodes.length})
      </h2>
      <a href={`/state/${district.stateSlug}`} class="text-xs font-semibold text-brand-600 hover:text-brand-700">
        ← Back to {district.state}
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {district.pincodes.map((pin) => (
        <a 
          href={`/pincode/${pin}`}
          class="bg-white p-3.5 rounded-xl border border-slate-200 hover:border-brand-500 hover:shadow-md transition-all text-center group"
        >
          <div class="font-mono text-base font-bold text-slate-900 group-hover:text-brand-600 transition-colors">
            {pin}
          </div>
          <div class="text-[11px] text-slate-400 mt-0.5 group-hover:text-brand-500">
            View Offices →
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
