---
import Layout from '../layouts/Layout.astro';
import DistanceCalculator from '../components/DistanceCalculator.astro';

export const prerender = true;
---

<Layout 
  title="PIN-to-PIN Distance & Transit Estimator - Calculate Distance Between Pincodes"
  description="Calculate straight-line aerial and road transit distance between any two Indian PIN codes with estimated delivery timeline and India Post distance tariff slabs."
  activePage="distance"
>
  <div class="bg-gradient-to-b from-pinDark-950 via-pinDark-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 text-center border-b border-slate-800">
    <div class="max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-pinDark-800 border border-slate-700 text-xs font-semibold text-brand-300 uppercase tracking-wider">
        Geographic Transit Engine
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        PIN-to-PIN Distance & Transit Estimator
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto">
        Compute accurate aerial and road transit distances between any two postal codes across India using official geographic coordinates.
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <DistanceCalculator />
  </div>
</Layout>
