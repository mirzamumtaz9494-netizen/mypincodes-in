---
import Layout from '../../layouts/Layout.astro';
import USAddressFormatter from '../../components/USAddressFormatter.astro';

export const prerender = true;
---

<Layout 
  title="USPS Address Formatter - CASS Standard Shipping Labels"
  description="Generate standardized USPS CASS-compliant shipping label addresses for domestic packages via USPS, FedEx, and UPS. Prevent misdelivery and return to sender."
  activePage="us"
>
  <div class="bg-gradient-to-b from-blue-950 via-slate-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 text-center">
    <div class="max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-xs font-semibold text-blue-400 uppercase tracking-wider">
        Logistics Standard Utility
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        USPS Standard Address Formatter
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto">
        Format US delivery addresses into standard USPS barcode-compatible layouts with state 2-letter codes and 5-digit ZIP codes.
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <USAddressFormatter />
  </div>
</Layout>
