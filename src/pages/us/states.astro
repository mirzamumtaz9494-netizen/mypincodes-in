---
import Layout from '../../layouts/Layout.astro';
import { getAllUSStates } from '../../utils/usPostalData';

export const prerender = true;

const states = getAllUSStates();
const totalZips = states.reduce((acc, s) => acc + s.zipcodesCount, 0);
---

<Layout 
  title="All 50 US States ZIP Code Directory - USPS Postal Codes"
  description="Browse ZIP codes across all 50 US States, District of Columbia, and Puerto Rico. Comprehensive USPS postal directory covering 41,488+ ZIP codes."
  activePage="us"
>
  <div class="bg-gradient-to-b from-blue-950 via-slate-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 text-center">
    <div class="max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-xs font-semibold text-blue-400 uppercase tracking-wider">
        United States Directory
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        United States Postal Directory by State
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto">
        Complete USPS directory covering 50 States, DC, and Territories with {totalZips.toLocaleString()} total ZIP codes.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {states.map((st) => (
        <a 
          href={`/us/state/${st.slug}`}
          class="bg-white p-4 rounded-xl border border-slate-200 hover:border-blue-500 hover:shadow-md transition-all text-center group"
        >
          <div class="text-xs font-bold text-blue-600 font-mono">{st.code}</div>
          <div class="text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors mt-0.5 truncate">
            {st.name}
          </div>
          <div class="text-xs text-slate-400 mt-1">
            {st.zipcodesCount.toLocaleString()} ZIP codes
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
