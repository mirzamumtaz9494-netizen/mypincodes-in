---
import Layout from '../../layouts/Layout.astro';
import SpeedPostCalculator from '../../components/SpeedPostCalculator.astro';
import AddressFormatter from '../../components/AddressFormatter.astro';
import { getPincodeData, getNearbyPincodes } from '../../utils/postalData';

// On-demand edge rendering via Vercel adapter
export const prerender = false;

const { pincode } = Astro.params;

if (!pincode || !/^\d{6}$/.test(pincode)) {
  return Astro.redirect('/');
}

const data = await getPincodeData(pincode);

if (!data) {
  return Astro.redirect('/');
}

const nearby = getNearbyPincodes(pincode, data.district, 10);
const primaryOffice = data.offices[0]?.name || 'Post Office';

// Postal Zone and Digit Hierarchy Breakdown
const firstDigit = pincode[0];
const zoneMap: Record<string, string> = {
  '1': 'Northern Zone (Delhi, Haryana, Punjab, Himachal Pradesh, J&K, Chandigarh)',
  '2': 'Northern Zone (Uttar Pradesh, Uttarakhand)',
  '3': 'Western Zone (Rajasthan, Gujarat, Daman & Diu, Dadra & Nagar Haveli)',
  '4': 'Western Zone (Maharashtra, Goa, Madhya Pradesh, Chhattisgarh)',
  '5': 'Southern Zone (Andhra Pradesh, Telangana, Karnataka)',
  '6': 'Southern Zone (Tamil Nadu, Kerala, Lakshadweep, Puducherry)',
  '7': 'Eastern Zone (West Bengal, Odisha, North Eastern States, Andaman & Nicobar)',
  '8': 'Eastern Zone (Bihar, Jharkhand)',
  '9': 'Army Postal Service (APS) / Field Post Office (FPO)'
};
const zoneName = zoneMap[firstDigit] || 'Indian Postal Geographical Zone';
const firstTwo = pincode.slice(0, 2);
const firstThree = pincode.slice(0, 3);
const lastThree = pincode.slice(3);

const hoCount = data.offices.filter(o => o.type === 'HO').length;
const soCount = data.offices.filter(o => o.type === 'SO').length;
const boCount = data.offices.filter(o => o.type === 'BO').length;
const deliveryCount = data.offices.filter(o => o.delivery.toLowerCase().includes('delivery') && !o.delivery.toLowerCase().includes('non')).length;

// Structured Data for Google Rich Snippets
const schemaJson = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: `${pincode} PIN Code - ${data.district}, ${data.state}`,
  address: {
    '@type': 'PostalAddress',
    postalCode: pincode,
    addressLocality: data.district,
    addressRegion: data.state,
    addressCountry: 'IN'
  },
  containsPlace: data.offices.map((off) => ({
    '@type': 'PostOffice',
    name: off.name,
    address: {
      '@type': 'PostalAddress',
      postalCode: pincode,
      addressLocality: data.district,
      addressRegion: data.state,
      addressCountry: 'IN'
    },
    ...(off.lat && off.lng ? {
      geo: {
        '@type': 'GeoCoordinates',
        latitude: off.lat,
        longitude: off.lng
      }
    } : {})
  }))
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `What post offices are under PIN code ${pincode}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `PIN code ${pincode} covers ${data.offices.length} post office(s) in ${data.district}, ${data.state}, including ${data.offices.map(o => o.name).slice(0, 5).join(', ')}.`
      }
    },
    {
      '@type': 'Question',
      name: `What is the delivery status for PIN code ${pincode}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${deliveryCount} of ${data.offices.length} post office(s) under PIN code ${pincode} provide daily doorstep mail and parcel delivery services.`
      }
    },
    {
      '@type': 'Question',
      name: `Which postal division and circle administers PIN ${pincode}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `PIN code ${pincode} is administered by the ${data.division} under the ${data.circle} in ${data.state}.`
      }
    },
    {
      '@type': 'Question',
      name: `Can I open an India Post Payments Bank (IPPB) account in ${pincode}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Yes, post offices under PIN code ${pincode} offer India Post Payments Bank (IPPB) micro-banking, Aadhaar-enabled payment services (AePS), and Post Office Savings Schemes.`
      }
    }
  ]
};
---

<Layout 
  title={`${pincode} PIN Code - ${data.district}, ${data.state} | Post Offices, Transit & Rates`}
  description={`Comprehensive postal intelligence for PIN code ${pincode} in ${data.district}, ${data.state}. Details on ${data.offices.length} post offices, delivery status, Speed Post tariffs, and IPPB services.`}
  activePage="home"
  schemaJson={[schemaJson, faqSchema]}
>
  <!-- Breadcrumbs -->
  <div class="bg-slate-100 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 text-xs text-slate-500 flex items-center gap-2">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>/</span>
      <a href="/states" class="hover:text-brand-600">States</a>
      <span>/</span>
      <a href={`/district/${data.state.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/${data.district.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="hover:text-brand-600">
        {data.district}
      </a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">{pincode}</span>
    </div>
  </div>

  <!-- Hero Header for PIN -->
  <div class="bg-gradient-to-b from-pinDark-950 via-pinDark-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-pinDark-800/90 border border-slate-700 text-xs font-semibold text-brand-300 uppercase tracking-wider mb-3">
            <span class="text-accent-400 font-bold">⚡</span> India Postal Data Reference
          </div>
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight font-mono text-white flex items-center gap-3">
            <span>{pincode}</span>
            <span class="text-base sm:text-lg font-sans font-normal text-slate-300">
              ({data.district}, {data.state})
            </span>
          </h1>
          <p class="text-slate-300 text-sm sm:text-base mt-2 max-w-2xl leading-relaxed">
            Administered by <strong>{data.division}</strong> under the <strong>{data.circle}</strong>. Serves {data.offices.length} postal facility/facilities including {primaryOffice}.
          </p>
        </div>

        <!-- Quick Summary Box -->
        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10 text-xs space-y-2 shrink-0">
          <div class="flex justify-between gap-6">
            <span class="text-slate-400">Postal Circle:</span>
            <span class="font-semibold text-white">{data.circle}</span>
          </div>
          <div class="flex justify-between gap-6">
            <span class="text-slate-400">Postal Division:</span>
            <span class="font-semibold text-white">{data.division}</span>
          </div>
          <div class="flex justify-between gap-6">
            <span class="text-slate-400">Postal Region:</span>
            <span class="font-semibold text-white">{data.region}</span>
          </div>
          <div class="flex justify-between gap-6">
            <span class="text-slate-400">State / UT:</span>
            <span class="font-semibold text-white">{data.state}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">

    <!-- Unique Editorial Section: Digit Architecture Breakdown for THIS Pincode -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm space-y-6">
      <div>
        <span class="text-xs font-bold text-brand-600 uppercase tracking-wider">PIN Architecture</span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mt-1">
          Understanding PIN Code {pincode} Structure
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          How the 6 digits in {pincode} guide mail sorting from national distribution centers to local delivery beats.
        </p>
      </div>

      <!-- Digit Blocks Visualizer -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
          <div class="text-2xl font-black font-mono text-brand-600">{firstDigit}</div>
          <div class="text-[11px] font-bold text-slate-800 mt-1">Zone: Digit 1</div>
          <div class="text-[10px] text-slate-500 mt-0.5">{zoneName}</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
          <div class="text-2xl font-black font-mono text-accent-600">{firstTwo}</div>
          <div class="text-[11px] font-bold text-slate-800 mt-1">Sub-Zone: Digits 1-2</div>
          <div class="text-[10px] text-slate-500 mt-0.5">{data.state} Postal Circle</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
          <div class="text-2xl font-black font-mono text-emerald-600">{firstThree}</div>
          <div class="text-[11px] font-bold text-slate-800 mt-1">Sorting District: 1-3</div>
          <div class="text-[10px] text-slate-500 mt-0.5">{data.division} Hub</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
          <div class="text-2xl font-black font-mono text-purple-600">{lastThree}</div>
          <div class="text-[11px] font-bold text-slate-800 mt-1">Delivery Beats: 4-6</div>
          <div class="text-[10px] text-slate-500 mt-0.5">{primaryOffice}</div>
        </div>
      </div>

      <div class="text-xs text-slate-600 leading-relaxed space-y-2 border-t border-slate-100 pt-4">
        <p>
          The postal code <strong>{pincode}</strong> is situated in <strong>{data.district}</strong> district, <strong>{data.state}</strong>. In the Indian postal index architecture, the first digit <code class="font-mono text-brand-700 bg-brand-50 px-1 py-0.5 rounded">{firstDigit}</code> routes all domestic parcels and letters directly into the <strong>{zoneName}</strong>. The first two digits <code class="font-mono text-accent-700 bg-accent-50 px-1 py-0.5 rounded">{firstTwo}</code> isolate the parcel to the <strong>{data.circle}</strong>.
        </p>
        <p>
          Once consignments reach the <strong>{data.division}</strong> sorting hub (designated by <code class="font-mono text-emerald-700 bg-emerald-50 px-1 py-0.5 rounded">{firstThree}</code>), the final three digits <code class="font-mono text-purple-700 bg-purple-50 px-1 py-0.5 rounded">{lastThree}</code> assign delivery responsibility across the <strong>{data.offices.length}</strong> designated delivery post office(s).
        </p>
      </div>
    </div>

    <!-- Post Offices Table -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold text-slate-900">
            Post Offices under PIN Code {pincode} ({data.offices.length})
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Network includes {hoCount > 0 ? `${hoCount} Head Office(s), ` : ''}{soCount > 0 ? `${soCount} Sub Office(s), ` : ''}{boCount > 0 ? `${boCount} Branch Office(s)` : ''}.
          </p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-slate-50 text-slate-700 font-bold uppercase tracking-wider border-b border-slate-200">
            <tr>
              <th class="p-4">Post Office Name</th>
              <th class="p-4">Office Category</th>
              <th class="p-4">Delivery Status</th>
              <th class="p-4">Postal Division</th>
              <th class="p-4">Geographic Coordinates</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-800">
            {data.offices.map((off) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-4 font-semibold text-slate-900 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-brand-500"></span>
                  {off.name}
                </td>
                <td class="p-4">
                  <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-bold ${
                    off.type === 'HO' ? 'bg-purple-100 text-purple-700' :
                    off.type === 'SO' ? 'bg-blue-100 text-blue-700' :
                    'bg-slate-100 text-slate-700'
                  }`}>
                    {off.type === 'HO' ? 'Head Office (HO)' :
                     off.type === 'SO' ? 'Sub Office (SO)' :
                     'Branch Office (BO)'}
                  </span>
                </td>
                <td class="p-4">
                  <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-semibold ${
                    off.delivery.toLowerCase().includes('delivery') && !off.delivery.toLowerCase().includes('non')
                      ? 'bg-emerald-100 text-emerald-800'
                      : 'bg-amber-100 text-amber-800'
                  }`}>
                    {off.delivery}
                  </span>
                </td>
                <td class="p-4 text-slate-600">{data.division}</td>
                <td class="p-4">
                  {off.lat && off.lng ? (
                    <a 
                      href={`https://maps.google.com/?q=${off.lat},${off.lng}`} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-brand-600 hover:text-brand-800 font-mono font-medium underline"
                    >
                      {off.lat}, {off.lng} ↗
                    </a>
                  ) : (
                    <span class="text-slate-400">Verified Geographic Grid</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Logistics & Delivery Capabilities Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm space-y-4">
      <h2 class="text-lg font-bold text-slate-900">
        Postal Services & Citizen Facilities in {pincode}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-slate-700">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
          <div class="font-bold text-slate-900 flex items-center gap-1.5">
            <span>📦</span> Speed Post & COD
          </div>
          <p class="text-slate-600">
            Speed Post, Registered Post, and Cash on Delivery (COD) booking are supported across all computerized counters in {data.division}.
          </p>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
          <div class="font-bold text-slate-900 flex items-center gap-1.5">
            <span>🏦</span> IPPB Micro-Banking
          </div>
          <p class="text-slate-600">
            Doorstep cash withdrawals via Aadhaar Enabled Payment System (AePS), utility payments, and DBT government subsidy disbursements.
          </p>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
          <div class="font-bold text-slate-900 flex items-center gap-1.5">
            <span>📈</span> Postal Savings Schemes
          </div>
          <p class="text-slate-600">
            Eligible for Sukanya Samriddhi (8.2%), PPF (7.1%), Senior Citizen Savings (8.2%), and National Savings Certificates (NSC).
          </p>
        </div>
      </div>
    </div>

    <!-- Pre-filled Speed Post Calculator -->
    <div>
      <div class="mb-4">
        <h2 class="text-xl font-bold text-slate-900">
          Calculate Speed Post Rate to {pincode}
        </h2>
        <p class="text-xs text-slate-500">
          Estimate exact India Post charges for sending letters or parcels to {data.district}, {data.state}.
        </p>
      </div>
      <SpeedPostCalculator defaultDestPin={pincode} />
    </div>

    <!-- Pre-filled Courier Address Formatter -->
    <div>
      <div class="mb-4">
        <h2 class="text-xl font-bold text-slate-900">
          Generate Shipping Label for {pincode}
        </h2>
        <p class="text-xs text-slate-500">
          Format standard postal addresses for deliveries heading to {primaryOffice}.
        </p>
      </div>
      <AddressFormatter defaultPin={pincode} defaultDistrict={data.district} defaultState={data.state} />
    </div>

    <!-- Frequently Asked Questions for THIS PIN -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm space-y-4">
      <h2 class="text-lg font-bold text-slate-900">
        Frequently Asked Questions: PIN Code {pincode}
      </h2>
      <div class="space-y-3 text-xs text-slate-600">
        <details class="p-3.5 bg-slate-50 rounded-xl border border-slate-100 group">
          <summary class="font-bold text-slate-900 cursor-pointer list-none flex justify-between items-center">
            <span>What post offices fall under PIN code {pincode}?</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-2 text-slate-600">
            PIN code {pincode} covers {data.offices.length} post office(s) in {data.district}, including {data.offices.map(o => o.name).slice(0, 4).join(', ')}.
          </p>
        </details>

        <details class="p-3.5 bg-slate-50 rounded-xl border border-slate-100 group">
          <summary class="font-bold text-slate-900 cursor-pointer list-none flex justify-between items-center">
            <span>What is the expected delivery transit timeline to {pincode}?</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-2 text-slate-600">
            According to India Post delivery norms, Speed Post consignments within {data.state} typically take 1 to 3 business days. Consignments from other states take 3 to 5 business days.
          </p>
        </details>

        <details class="p-3.5 bg-slate-50 rounded-xl border border-slate-100 group">
          <summary class="font-bold text-slate-900 cursor-pointer list-none flex justify-between items-center">
            <span>How do I address a parcel for delivery to {primaryOffice}?</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-2 text-slate-600">
            Write the recipient name, house/flat number, road/locality, landmark, followed clearly by "{primaryOffice}, {data.district}, {data.state} - {pincode}". Always include a 10-digit mobile number for courier tracking SMS notifications.
          </p>
        </details>
      </div>
    </div>

    <!-- Nearby / Related PIN codes in the same district -->
    {nearby.length > 0 && (
      <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm">
        <h2 class="text-base font-bold text-slate-900 mb-4">
          Other PIN Codes in {data.district}
        </h2>
        <div class="flex flex-wrap gap-2">
          {nearby.map((np) => (
            <a 
              href={`/pincode/${np}`}
              class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-brand-50 hover:text-brand-700 hover:border-brand-300 border border-slate-200 text-xs font-mono font-bold text-slate-700 transition-all"
            >
              {np}
            </a>
          ))}
        </div>
      </div>
    )}

  </div>
</Layout>
