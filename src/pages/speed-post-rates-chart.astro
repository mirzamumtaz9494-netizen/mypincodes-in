          <p class="text-xs text-slate-500 mt-1">Or ₹1,000 (whichever is lower) for delayed delivery under citizen charter.</p>
        </div>
      </div>
    </section>

    <!-- Speed Post vs Registered Post Comparison -->
    <section class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-2">Speed Post vs. Registered Post: Key Differences</h2>
      <p class="text-xs sm:text-sm text-slate-500 mb-6">Choosing the right India Post service for your letters and parcels.</p>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border border-slate-200 rounded-xl overflow-hidden">
          <thead class="bg-slate-100 text-slate-700 font-bold uppercase tracking-wider text-xs">
            <tr>
              <th class="p-3 border-b">Feature</th>
              <th class="p-3 border-b text-brand-700">Speed Post (Express)</th>
              <th class="p-3 border-b">Registered Post</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-800">
            <tr>
              <td class="p-3 font-semibold">Priority & Speed</td>
              <td class="p-3 font-bold text-brand-600">High (1 to 5 days)</td>
              <td class="p-3">Normal (5 to 10 days)</td>
            </tr>
            <tr class="bg-slate-50/50">
              <td class="p-3 font-semibold">Maximum Weight</td>
              <td class="p-3 font-semibold">Up to 35 kg</td>
              <td class="p-3">Up to 2 kg (Letters) / 20 kg (Parcels)</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold">Tracking</td>
              <td class="p-3 font-semibold text-emerald-600">Real-time Online & SMS</td>
              <td class="p-3">Limited milestone tracking</td>
            </tr>
            <tr class="bg-slate-50/50">
              <td class="p-3 font-semibold">Starting Price</td>
              <td class="p-3 font-semibold">₹15 + GST</td>
              <td class="p-3">₹20 base + letter weight</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold">Best Used For</td>
              <td class="p-3 font-semibold">Parcels, e-commerce, urgent documents</td>
              <td class="p-3">Legal notices, official certificates</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Frequently Asked Questions (FAQ Section) -->
    <section class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-6">Frequently Asked Questions (Speed Post FAQs)</h2>
      
      <div class="space-y-4">
        {faqSchema.mainEntity.map((faq, index) => (
          <div class="p-4 rounded-xl bg-slate-50/70 border border-slate-200">
            <h3 class="font-bold text-slate-900 text-sm sm:text-base flex items-start gap-2">
              <span class="text-brand-600 font-mono text-sm">Q{index + 1}.</span>
              <span>{faq.name}</span>
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-2 pl-6 leading-relaxed">
              {faq.acceptedAnswer.text}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom Action Navigation -->
    <div class="p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-brand-600 to-emerald-700 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-lg shadow-brand-600/10">
      <div>
        <h3 class="text-xl font-bold">Ready to calculate postage or look up a PIN code?</h3>
        <p class="text-xs sm:text-sm text-emerald-100 mt-1">Search 157,000+ Indian post offices or calculate exact shipping cost.</p>
      </div>
      <div class="flex items-center gap-3">
        <a 
          href="/" 
          class="px-4 py-2.5 rounded-xl bg-white text-brand-700 font-bold text-xs uppercase tracking-wider hover:bg-emerald-50 transition-all shadow-md"
        >
          Search PIN Codes
        </a>
        <a 
          href="/speed-post-calculator" 
          class="px-4 py-2.5 rounded-xl bg-emerald-900/60 border border-emerald-400 text-white font-bold text-xs uppercase tracking-wider hover:bg-emerald-900/80 transition-all"
        >
          Calculator
        </a>
      </div>
    </div>

  </div>
</Layout>
