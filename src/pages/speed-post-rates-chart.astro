---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How are India Post Speed Post charges calculated?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Speed Post charges in India are calculated based on two main factors: the total weight of the parcel/document (in weight slabs up to 35 kg) and the distance between sender and recipient PIN codes (Local, up to 200 km, 201 to 1000 km, 1001 to 2000 km, and above 2000 km). An 18% Goods and Services Tax (GST) is added to the base tariff.'
      }
    },
    {
      '@type': 'Question',
      name: 'Is 18% GST included in the Speed Post rate chart?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The base tariff schedule published by the Department of Posts excludes taxes. An 18% GST (CGST 9% + SGST 9% for intra-state, or IGST 18% for inter-state) is levied on the total postage amount.'
      }
    },
    {
      '@type': 'Question',
      name: 'What is the maximum weight permitted for Speed Post in India?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The maximum allowable weight limit for domestic Speed Post articles is 35 kilograms (35 kg).'
      }
    },
    {
      '@type': 'Question',
      name: 'How much does Speed Post cost for a 500 gram parcel?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For a 500 gram parcel, base Speed Post charges are ₹30 for local delivery, ₹50 for distances up to 200 km, ₹60 for 201-1000 km, ₹70 for 1001-2000 km, and ₹80 for over 2000 km. After adding 18% GST, the final payable cost ranges from ₹35.40 (local) to ₹94.40 (>2000 km).'
      }
    },
    {
      '@type': 'Question',
      name: 'What is the expected delivery time for Speed Post?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Standard delivery timeframes under Department of Posts norms are: Local (same city): 1 to 2 days; Metro to Metro: 1 to 3 days; State Capital to State Capital: 2 to 4 days; District headquarters to District headquarters: 2 to 4 days; Rest of the country: 4 to 6 business days.'
      }
    },
    {
      '@type': 'Question',
      name: 'What is the difference between Speed Post and Registered Post?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Speed Post is a fast-track, time-bound express service with online real-time SMS/web tracking and delivery within 1-5 days. Registered Post is an economical service focused on secure, signature-confirmed physical delivery but typically takes 5-10 business days without real-time priority transit.'
      }
    }
  ]
};
---

<Layout
  title="India Post Speed Post Rate Chart 2026 - Domestic Charges, Slabs & Delivery Norms"
  description="Official India Post domestic Speed Post rate chart for 2026. Complete postage tariff matrix by weight slabs (up to 35 kg), distance tiers, 18% GST calculation, delivery timelines, and FAQs."
  canonical="https://mypincodes.in/speed-post-rates-chart"
  activePage="calculator"
  schemaJson={faqSchema}
>
  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-pinDark-950 via-pinDark-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 text-center border-b border-slate-800">
    <div class="max-w-4xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-pinDark-800 border border-slate-700 text-xs font-semibold text-accent-400 uppercase tracking-wider">
        <span class="text-accent-400 font-bold">⚡</span> Official Department of Posts (DoP) Schedule 2026
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        India Post Speed Post Rate Chart 2026
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto">
        Complete tariff breakdown for domestic Speed Post letters, parcels, and documents across all weight slabs and distance tiers, with delivery timeframes and 18% GST calculation.
      </p>

      <!-- Instant Calculator CTA -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a 
          href="/speed-post-calculator" 
