        >
          <span>Calculate Your Exact Postage</span>
          <span>→</span>
        </a>
        <a 
          href="/distance-calculator" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm border border-slate-700 transition-all"
        >
          <span>Find PIN Distance</span>
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    
    <!-- Quick Summary Highlight Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
        <div class="text-xs uppercase font-bold text-slate-400">Starting Price</div>
        <div class="text-2xl font-black text-brand-600 mt-1">₹15 <span class="text-xs font-normal text-slate-500">+ 18% GST</span></div>
        <div class="text-xs text-slate-500 mt-1">For local letters up to 50g</div>
      </div>
      <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
        <div class="text-xs uppercase font-bold text-slate-400">Maximum Weight</div>
        <div class="text-2xl font-black text-slate-900 mt-1">35 kg</div>
        <div class="text-xs text-slate-500 mt-1">Domestic Speed Post limit</div>
      </div>
      <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
        <div class="text-xs uppercase font-bold text-slate-400">Delivery Time</div>
        <div class="text-2xl font-black text-slate-900 mt-1">1 to 5 Days</div>
        <div class="text-xs text-slate-500 mt-1">Across 19,000+ PIN codes</div>
      </div>
      <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
        <div class="text-xs uppercase font-bold text-slate-400">Tracking Included</div>
        <div class="text-2xl font-black text-emerald-600 mt-1">Free 24/7</div>
        <div class="text-xs text-slate-500 mt-1">SMS & Online tracking</div>
      </div>
    </div>

    <!-- Official Domestic Speed Post Tariff Matrix -->
    <section class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
